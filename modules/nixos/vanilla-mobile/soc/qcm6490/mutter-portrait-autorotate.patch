+/*
+ * Orientation tracking is inhibited exactly while the panel is not
+ * orientation-managed (e.g. a convertible docked outside tablet mode) and
+ * the initial orientation has already been handled. Track that state
+ * explicitly and toggle the inhibit only on real transitions, so a device
+ * that is always managed (a phone/tablet with a touchscreen and no
+ * tablet-mode switch) is never left permanently inhibited. Backported from
+ * mutter main; the 50.2 code inhibited unconditionally on the first event
+ * and wedged auto-rotation on such devices.
+ */
+static void
+sync_orientation_unmanaged_inhibit (MetaMonitorManager *manager)
+{
+  MetaMonitorManagerPrivate *priv =
+    meta_monitor_manager_get_instance_private (manager);
+  MetaOrientationManager *orientation_manager =
+    meta_backend_get_orientation_manager (manager->backend);
+  gboolean should_inhibit;
+
+  should_inhibit = !manager->panel_orientation_managed &&
+                   priv->initial_orient_change_done;
+
+  if (priv->orientation_unmanaged_inhibited == should_inhibit)
+    return;
+
+  priv->orientation_unmanaged_inhibited = should_inhibit;
+
+  if (should_inhibit)
+    meta_orientation_manager_inhibit_tracking (orientation_manager);
+  else
+    meta_orientation_manager_uninhibit_tracking (orientation_manager);
+}
