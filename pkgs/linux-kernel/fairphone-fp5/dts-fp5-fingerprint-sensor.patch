+
+	fpsensor_pwr_low: fpsensor-pwr-low-state {
+		pins = "gpio60";
+		function = "gpio";
+		output-low;
+		bias-disable;
+	};
+
+	fpsensor_rst_high: fpsensor-rst-high-state {
+		pins = "gpio35";
+		function = "gpio";
+		output-high;
+		bias-disable;
+	};
+
+	fpsensor_rst_low: fpsensor-rst-low-state {
+		pins = "gpio35";
+		function = "gpio";
+		output-low;
+		bias-disable;
+	};
+
