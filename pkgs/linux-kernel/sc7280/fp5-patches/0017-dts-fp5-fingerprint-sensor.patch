From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marcus Ramberg <marcus@means.no>
Date: Sun, 25 Oct 2026 17:53:25 +0100
Subject: [PATCH 17/20] arm64: dts: qcom: qcm6490-fairphone-fp5: add the
 fingerprint sensor

The FocalTech FT9362 in the power button. The sensor's SPI bus belongs
to the secure world, so the node carries no SPI controller: it owns only
the pins Linux is left with -- reset on GPIO35, power on GPIO60, and the
interrupt on GPIO34 -- which the trusted application needs driven before
it can talk to the sensor.

The pinctrl state names are the ones the driver looks up, and come from
the vendor kernel.

Signed-off-by: Marcus Ramberg <marcus@means.no>
---
 .../boot/dts/qcom/qcm6490-fairphone-fp5.dts   | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts b/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
index 5cf3123a3a28..f863b8796ef4 100644
--- a/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
+++ b/arch/arm64/boot/dts/qcom/qcm6490-fairphone-fp5.dts
@@ -251,6 +251,29 @@ vreg_vtof_ldo_2p8: regulator-vtof-ldo-2p8 {
 		vin-supply = <&vreg_bob>;
 	};
 
+	fingerprint {
+		compatible = "focaltech,ft9362";
+		interrupts-extended = <&tlmm 34 IRQ_TYPE_EDGE_RISING>;
+
+		/*
+		 * The trusted application that owns the sensor. The SPI
+		 * instance belongs to TrustZone, so every capture and match
+		 * happens inside this application and a client has to name it
+		 * to open a session.
+		 */
+		firmware-name = "focal32";
+		pinctrl-names = "fpsensor_finger_rst_low",
+				"fpsensor_finger_rst_high",
+				"fpsensor_eint_as_int",
+				"fpsensor_finger_power_low",
+				"fpsensor_finger_power_high";
+		pinctrl-0 = <&fpsensor_rst_low>;
+		pinctrl-1 = <&fpsensor_rst_high>;
+		pinctrl-2 = <&fpsensor_irq>;
+		pinctrl-3 = <&fpsensor_pwr_low>;
+		pinctrl-4 = <&fpsensor_pwr_high>;
+	};
+
 	reserved-memory {
 		cont_splash_mem: cont-splash@e1000000 {
 			reg = <0x0 0xe1000000 0x0 0x2300000>;
@@ -1658,6 +1681,41 @@ &tlmm {
 	 */
 	gpio-reserved-ranges = <32 2>, <56 4>;
 
+	fpsensor_irq: fpsensor-irq-state {
+		pins = "gpio34";
+		function = "gpio";
+		input-enable;
+		bias-pull-down;
+	};
+
+	fpsensor_pwr_high: fpsensor-pwr-high-state {
+		pins = "gpio60";
+		function = "gpio";
+		output-high;
+		bias-disable;
+	};
+
+	fpsensor_pwr_low: fpsensor-pwr-low-state {
+		pins = "gpio60";
+		function = "gpio";
+		output-low;
+		bias-disable;
+	};
+
+	fpsensor_rst_high: fpsensor-rst-high-state {
+		pins = "gpio35";
+		function = "gpio";
+		output-high;
+		bias-disable;
+	};
+
+	fpsensor_rst_low: fpsensor-rst-low-state {
+		pins = "gpio35";
+		function = "gpio";
+		output-low;
+		bias-disable;
+	};
+
 	pm8008_int_default: pm8008-int-default-state {
 		pins = "gpio25";
 		function = "gpio";
