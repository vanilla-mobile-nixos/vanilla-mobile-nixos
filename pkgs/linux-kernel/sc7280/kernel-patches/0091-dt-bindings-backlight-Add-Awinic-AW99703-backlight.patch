From de05e33e948f3515839d7b8b9ac4a6d40fb9df0d Mon Sep 17 00:00:00 2001
From: Luka Panio <lukapanio@gmail.com>
Date: Thu, 19 Mar 2026 14:05:20 +0100
Subject: [PATCH 091/136] dt-bindings: backlight: Add Awinic AW99703 backlight

Add Awinic AW99703 backlight binding documentation.

Signed-off-by: Luka Panio <lukapanio@gmail.com>
Signed-off-by: Marcus Ramberg <marcus@means.no>
---
 .../leds/backlight/awinic,aw99703.yaml        | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/leds/backlight/awinic,aw99703.yaml

diff --git a/Documentation/devicetree/bindings/leds/backlight/awinic,aw99703.yaml b/Documentation/devicetree/bindings/leds/backlight/awinic,aw99703.yaml
new file mode 100644
index 000000000000..3871e2a5494c
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/backlight/awinic,aw99703.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/backlight/awinic,aw99703.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Awinic AW99703 3-channel WLED Backlight Driver
+
+maintainers:
+  - Luka Panio <lukapanio0@gmail.com>
+
+allOf:
+  - $ref: common.yaml#
+
+properties:
+  compatible:
+    const: awinic,aw99703
+
+  reg:
+    maxItems: 1
+
+  enable-gpios:
+    description: GPIO to use to enable/disable the backlight (HWEN pin).
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - enable-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        backlight@36 {
+            compatible = "awinic,aw99703";
+            reg = <0x36>;
+            enable-gpios = <&pm8350c_gpios 7 GPIO_ACTIVE_HIGH>;
+        };
+    };
+
+...
-- 
