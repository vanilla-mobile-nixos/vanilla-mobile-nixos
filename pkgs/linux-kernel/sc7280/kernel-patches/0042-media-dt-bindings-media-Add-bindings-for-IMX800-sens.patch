From 9def099d581450b6c114e9c1e973e99e7d144e10 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Matti=20Lehtim=C3=A4ki?= <matti.lehtimaki@gmail.com>
Date: Sat, 28 Oct 2023 23:52:23 +0300
Subject: [PATCH 042/136] media: dt-bindings: media: Add bindings for IMX800
 sensor
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add bindings documentaion for the Sony IMX800 camera sensor.

Signed-off-by: Matti Lehtimäki <matti.lehtimaki@gmail.com>
Signed-off-by: Marcus Ramberg <marcus@means.no>
---
 .../bindings/media/i2c/sony,imx800.yaml       | 106 ++++++++++++++++++
 1 file changed, 106 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/sony,imx800.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/sony,imx800.yaml b/Documentation/devicetree/bindings/media/i2c/sony,imx800.yaml
new file mode 100644
index 000000000000..d924b7c26954
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/sony,imx800.yaml
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/sony,imx800.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Sony IMX800 Sensor
+
+maintainers:
+  - Matti Lehtimäki <matti.lehtimaki@gmail.com>
+
+description: |-
+  IMX800 sensor is a Sony CMOS active pixel digital image sensor with an active
+  array size of 4096H x 3072V. It is programmable through I2C interface. The
+  I2C client address is fixed to 0x1a as per sensor data sheet. Image data is
+  sent through MIPI CSI-2.
+
+properties:
+  compatible:
+    const: sony,imx800
+
+  reg:
+    description: I2C device address
+    maxItems: 1
+
+  assigned-clocks: true
+  assigned-clock-parents: true
+  assigned-clock-rates: true
+
+  clocks:
+    description: Clock frequency 6MHz, 12MHz, 18MHz, 24MHz or 27MHz
+    maxItems: 1
+
+  vana1-supply:
+    description:
+      Analog voltage (VANA) supply, 2.8 V
+
+  vana2-supply:
+    description:
+      Analog voltage (VANA) supply, 1.8 V
+
+  vdig-supply:
+    description:
+      Digital I/O voltage (VDIG) supply, 1.1 V
+
+  vif-supply:
+    description:
+      Interface voltage (VIF) supply, 1.2 or 1.8 V
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the XCLR pin, if any.
+    maxItems: 1
+
+  port:
+    additionalProperties: false
+    $ref: /schemas/graph.yaml#/$defs/port-base
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes: true
+          link-frequencies: true
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@1a {
+            compatible = "sony,imx800";
+            reg = <0x1a>;
+            clocks = <&imx800_clk>;
+
+            assigned-clocks = <&imx800_clk>;
+            assigned-clock-parents = <&imx800_clk_parent>;
+            assigned-clock-rates = <24000000>;
+
+            port {
+                imx800: endpoint {
+                    remote-endpoint = <&cam>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <600000000>;
+                };
+            };
+        };
+    };
+...
