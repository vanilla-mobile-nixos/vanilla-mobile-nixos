From 095760d8aa7461a7e6e5a0b972ba2dc657018616 Mon Sep 17 00:00:00 2001
From: Val Packett <val@packett.cool>
Date: Wed, 6 May 2026 18:12:00 -0300
Subject: [PATCH 101/136] arm64: dts: qcom: motorola-dubai: Add Novatek NT37701
 display panel [XXX]

Signed-off-by: Val Packett <val@packett.cool>
Signed-off-by: Marcus Ramberg <marcus@means.no>
---
 .../qcom/sm7325-motorola-dubai-common.dtsi    | 40 +++++++++++++++++++
 .../dts/qcom/sm7325-motorola-dubai-csot.dts   |  5 +++
 .../dts/qcom/sm7325-motorola-dubai-tianma.dts |  5 +++
 3 files changed, 50 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
index 3860ab8508a0..c2faddfb69e6 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-common.dtsi
@@ -732,6 +732,46 @@ &ipa {
 	status = "okay";
 };
 
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi {
+	vdda-supply = <&vdd_a_dsi_0_1p2>;
+	status = "okay";
+
+	panel: panel@0 {
+		reg = <0>;
+
+		reset-gpios = <&tlmm 44 GPIO_ACTIVE_LOW>;
+
+		vdd-supply = <&disp_vci_3p0>;
+		vddio-supply = <&disp_iovcc_1p8>;
+
+		pinctrl-0 = <&oled_reset_n>,
+			    <&mdp_vsync_p>;
+		pinctrl-names = "default";
+
+		status = "disabled";
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi_phy {
+	vdds-supply = <&vdd_a_dsi_0_0p9>;
+	status = "okay";
+};
+
 &pm7250b_adc {
 	channel@4e {
 		reg = <ADC5_AMUX_THM2_100K_PU>;
diff --git a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-csot.dts b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-csot.dts
index d53a729f71da..0f8ccde666d4 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-csot.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-csot.dts
@@ -11,3 +11,8 @@ / {
 	model = "Motorola Edge 30 (CSOT)";
 	compatible = "motorola,dubai", "qcom,sm7325";
 };
+
+&panel {
+	compatible = "csot,nt37701-dubai", "novatek,nt37701";
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-tianma.dts b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-tianma.dts
index 7b843c407f88..97e649f53f44 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-tianma.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-motorola-dubai-tianma.dts
@@ -11,3 +11,8 @@ / {
 	model = "Motorola Edge 30 (Tianma)";
 	compatible = "motorola,dubai", "qcom,sm7325";
 };
+
+&panel {
+	compatible = "tianma,nt37701-dubai", "novatek,nt37701";
+	status = "okay";
+};
-- 
2.55.0

