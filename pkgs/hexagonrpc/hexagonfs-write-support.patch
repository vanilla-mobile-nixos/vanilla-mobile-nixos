 	return ret;
 }
+
+static int phys_fd_of(struct hexagonfs_fd *fd)
+{
+	if (fd == NULL || fd->ops == NULL || fd->ops->phys_fd == NULL)
+		return -EROFS;
+
+	return fd->ops->phys_fd(fd);
+}
+
+/*
+ * Walk every path segment except the last, as hexagonfs_openat() would, and
+ * hand back the containing directory along with the final segment name. The
+ * returned directory chain must be released with destroy_file_descriptor()
+ * (or adopted as the "up" chain of a new descriptor).
+ */
+static int walk_to_parent(struct hexagonfs_fd **fds,
+			  int rootfd, int dirfd,
+			  const char *name,
+			  struct hexagonfs_fd **parent_out,
+			  char **base_out)
+{
+	struct hexagonfs_fd *fd;
+	const char *curr = name;
+	char *segment = NULL;
+	bool expect_dir;
+	int selected = dirfd;
+	int ret = 0;
+
+	if (*curr == '/') {
+		selected = rootfd;
+
+		while (*curr == '/')
+			curr++;
+	}
+
+	if (selected < 0 || selected >= HEXAGONFS_MAX_FD
+	 || fds[selected] == NULL)
+		return -EBADF;
+
+	fd = fds[selected];
+
+	if (*curr == '\0')
+		return -EINVAL;
+
+	while (*curr != '\0' && !ret) {
+		segment = copy_segment_and_advance(curr, &expect_dir, &curr);
+		if (segment == NULL) {
+			ret = -ENOMEM;
+			break;
+		}
+
+		if (*curr == '\0')
+			break;
+
+		if (!strcmp(segment, ".")) {
+			/* stay in place */
+		} else if (!strcmp(segment, "..")) {
+			fd = pop_dir(fd, fds[rootfd]);
+		} else {
+			ret = fd->ops->openat(fd, segment, true, &fd);
+		}
+
+		free(segment);
+		segment = NULL;
+	}
+
+	if (!ret && (segment == NULL
+		  || !strcmp(segment, ".")
+		  || !strcmp(segment, "..")))
+		ret = -EINVAL;
+
+	if (ret) {
+		free(segment);
+		destroy_file_descriptor(fd);
+		return ret;
+	}
+
+	*parent_out = fd;
+	*base_out = segment;
+
+	return 0;
+}
+
+int hexagonfs_openat_write(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+			   const char *name, bool append)
+{
+	struct hexagonfs_fd *parent;
+	struct hexagonfs_fd *fd;
+	char *base;
+	int pfd, ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, name, &parent, &base);
+	if (ret)
+		return ret;
+
+	pfd = phys_fd_of(parent);
+	if (pfd < 0) {
+		ret = pfd;
+		goto err;
+	}
+
+	ret = hexagonfs_mapped_open_for_write(pfd, base, append, parent, &fd);
+	if (ret)
+		goto err;
+
+	free(base);
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0) {
+		destroy_file_descriptor(fd);
+		return ret;
+	}
+
+	return ret;
+
+err:
+	free(base);
+	destroy_file_descriptor(parent);
+	return ret;
+}
+
+ssize_t hexagonfs_write(struct hexagonfs_fd **fds, int fileno, size_t size, const void *ptr)
+{
+	struct hexagonfs_fd *fd;
+	ssize_t ret;
+	int pfd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	pfd = phys_fd_of(fd);
+	if (pfd < 0)
+		return pfd;
+
+	ret = write(pfd, ptr, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+int hexagonfs_fsync(struct hexagonfs_fd **fds, int fileno)
+{
+	struct hexagonfs_fd *fd;
+	int pfd;
+
+	if (fileno < 0 || fileno >= HEXAGONFS_MAX_FD)
+		return -EBADF;
+
+	fd = fds[fileno];
+	if (fd == NULL)
+		return -EBADF;
+
+	pfd = phys_fd_of(fd);
+	if (pfd < 0)
+		return pfd;
+
+	if (fsync(pfd))
+		return -errno;
+
+	return 0;
+}
+
+int hexagonfs_remove(struct hexagonfs_fd **fds, int rootfd, int dirfd, const char *name)
+{
+	struct hexagonfs_fd *parent;
+	char *base;
+	int pfd, ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, name, &parent, &base);
+	if (ret)
+		return ret;
+
+	pfd = phys_fd_of(parent);
+	if (pfd < 0)
+		ret = pfd;
+	else if (unlinkat(pfd, base, 0))
+		ret = -errno;
+
+	free(base);
+	destroy_file_descriptor(parent);
+
+	return ret;
+}
+
+int hexagonfs_rename(struct hexagonfs_fd **fds, int rootfd, int dirfd,
+		     const char *oldname, const char *newname)
+{
+	struct hexagonfs_fd *oldp, *newp;
+	char *oldbase = NULL, *newbase = NULL;
+	int ofd, nfd, ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, oldname, &oldp, &oldbase);
+	if (ret)
+		return ret;
+
+	ret = walk_to_parent(fds, rootfd, dirfd, newname, &newp, &newbase);
+	if (ret)
+		goto out_old;
+
+	ofd = phys_fd_of(oldp);
+	nfd = phys_fd_of(newp);
+	if (ofd < 0 || nfd < 0)
+		ret = ofd < 0 ? ofd : nfd;
+	else if (renameat(ofd, oldbase, nfd, newbase))
+		ret = -errno;
+
+	free(newbase);
+	destroy_file_descriptor(newp);
+out_old:
+	free(oldbase);
+	destroy_file_descriptor(oldp);
+
+	return ret;
+}
 
 int hexagonfs_close(struct hexagonfs_fd **fds, int fileno)
 {
