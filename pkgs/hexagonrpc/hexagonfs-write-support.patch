+
+int hexagonfs_mapped_open_for_write(int dir_osfd, const char *base,
+				    bool append, struct hexagonfs_fd *up,
+				    struct hexagonfs_fd **out)
+{
+	struct hexagonfs_fd *fd;
+	struct mapped_ctx *ctx;
+	int flags = O_WRONLY | O_CREAT | (append ? O_APPEND : O_TRUNC);
+	int ret;
+
+	ctx = malloc(sizeof(struct mapped_ctx));
+	if (ctx == NULL)
+		return -ENOMEM;
+
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (fd == NULL) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	ctx->fd = openat(dir_osfd, base, flags, 0644);
+	if (ctx->fd == -1) {
+		ret = -errno;
+		goto err_free_fd;
+	}
+
+	ctx->dir = NULL;
+
+	fd->is_assigned = false;
+	fd->up = up;
+	fd->ops = &hexagonfs_mapped_ops;
+	fd->data = ctx;
+
+	*out = fd;
+
+	return 0;
+
+err_free_fd:
+	free(fd);
+err:
+	free(ctx);
+	return ret;
+}
